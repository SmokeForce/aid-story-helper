{
  "manifest_version": 3,
  "name": "AID Story Helper",
  "version": "1.1.1",
  "description": "Local archive + character tracking for AI Dungeon.",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.aidungeon.com/*",
    "https://docs.google.com/document/d/1na9MeTcx0QY6MkZdQSkFQFL91sT8BSiJ_6gxrC5sNEU/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://play.aidungeon.com/*", "*://beta.aidungeon.com/*", "*://alpha.aidungeon.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://play.aidungeon.com/*", "*://beta.aidungeon.com/*", "*://alpha.aidungeon.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aid-story-manager@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
